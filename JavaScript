// 加載所有路線function loadRoutes() {
 const routesDiv = document.getElementById('routes');
 routesDiv.innerHTML = '';
 busRoutes.forEach(route => {
 const card = document.createElement('div');
 card.className = 'route-card';
 card.innerHTML = `<strong>${route.company} ${route.route}:</strong> ${route.from} → ${route.to}`;
 routesDiv.appendChild(card);
 });
 vanRoutes.forEach(route => {
 const card = document.createElement('div');
 card.className = 'route-card';
 card.innerHTML = `<strong>${route.type} ${route.route}:</strong> ${route.from} → ${route.to}`;
 routesDiv.appendChild(card);
 });
}

// 加載所有站點function loadStations() {
 const stationsDiv = document.getElementById('stations');
 stationsDiv.innerHTML = '';
 mtrStations.forEach(station => {
 const card = document.createElement('div');
 card.className = 'station-card';
 card.innerHTML = `<strong>${station.line}:</strong> ${station.station}`;
 stationsDiv.appendChild(card);
 });
 lightRailStations.forEach(station => {
 const card = document.createElement('div');
 card.className = 'station-card';
 card.innerHTML = `<strong>${station.line}:</strong> ${station.station}`;
 stationsDiv.appendChild(card);
 });
}

//事件監聽document.getElementById('loadRoutes').addEventListener('click', loadRoutes);
document.getElementById('loadStations').addEventListener('click', loadStations);

